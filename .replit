modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "openjdk17", "imagemagick"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[agent]
integrations = ["javascript_stripe:1.0.0", "javascript_sendgrid:1.0.0", "javascript_openai:1.0.0", "javascript_log_in_with_replit:1.0.0"]

[userenv]

[userenv.shared]
VITE_REVENUECAT_APPLE_API_KEY = "appl_jWnxLTGgndDEuLfvrDcnukFGGIp"
WINBACK_DRIP_ENABLED = "true"
VITE_APPLE_CLIENT_ID = "com.themomapp.web"
VITE_REVENUECAT_GOOGLE_API_KEY = "goog_XcuuBhvjFivaiWvlJDMHrsRmJhX"
